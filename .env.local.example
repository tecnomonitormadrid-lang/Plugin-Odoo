ODOO_IMAGE=odoo:19.0
APP_ENV=local
CONNECTOR_API_PORT=8081
CONNECTOR_DATABASE_URL=postgresql+psycopg2://odoo:odoo_dev_password_change_me@db:5432/postgres
ODOO_BASE_URL=http://odoo:8069
ODOO_PUSH_PATH=/connector/tickets
SYNC_BATCH_SIZE=50
SYNC_TIMEOUT_SECONDS=10
SYNC_MAX_RETRIES=5
SYNC_BACKOFF_BASE_SECONDS=30
SYNC_BACKOFF_MAX_SECONDS=1800
ODOO_USER=admin
ODOO_PASSWORD=admin

POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_dev_password_change_me

ODOO_HTTP_PORT=8069
ODOO_LONGPOLLING_PORT=8072
ADMINER_PORT=8080
