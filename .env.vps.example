ODOO_IMAGE=odoo:19.0
APP_ENV=vps-dev
CONNECTOR_API_PORT=8081
CONNECTOR_DATABASE_URL=postgresql+psycopg2://odoo:replace_with_strong_password@db:5432/postgres
ODOO_BASE_URL=http://odoo:8069
ODOO_PUSH_PATH=/connector/tickets
SYNC_BATCH_SIZE=100
SYNC_TIMEOUT_SECONDS=10
SYNC_MAX_RETRIES=8
SYNC_BACKOFF_BASE_SECONDS=30
SYNC_BACKOFF_MAX_SECONDS=3600
ODOO_USER=admin
ODOO_PASSWORD=replace_with_strong_password

POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=replace_with_strong_password

ODOO_HTTP_PORT=8069
ODOO_LONGPOLLING_PORT=8072
ADMINER_PORT=18080
