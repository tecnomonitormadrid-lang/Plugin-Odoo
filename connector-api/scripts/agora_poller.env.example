# URL base del API de Agora
AGORA_BASE_URL=https://api.agora.example.com

# Endpoint para tickets cerrados (debe aceptar ?since=ISO8601)
AGORA_CLOSED_TICKETS_PATH=/api/v1/tickets/closed

# Token/API key de Agora
AGORA_API_TOKEN=replace_with_real_token

# Endpoint del connector-api
CONNECTOR_TICKETS_URL=http://localhost:8081/api/v1/tickets

# Polling
AGORA_POLL_INTERVAL_SECONDS=30
AGORA_REQUEST_TIMEOUT_SECONDS=15
AGORA_STATE_FILE=./scripts/agora_poller_state.json

# true para pruebas sin publicar realmente al connector
AGORA_DRY_RUN=true
